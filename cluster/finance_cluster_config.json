{
  "cluster_name": "Finance Data Processing Cluster",
  "spark_version": "7.3.x-scala2.12",
  "node_type_id": "Standard_DS3_v2",
  "driver_node_type_id": "Standard_DS3_v2",
  "autoscale": {
    "min_workers": 2,
    "max_workers": 5
  },
  "autotermination_minutes": 30,
  "spark_conf": {
    "spark.databricks.delta.preview.enabled": "true",
    "spark.sql.files.maxPartitionBytes": "134217728",
    "spark.sql.shuffle.partitions": "200",
    "spark.databricks.delta.autoCompact.enabled": "true",
    "spark.databricks.delta.optimizeWrite.enabled": "true"
  },
  "spark_env_vars": {
    "PYSPARK_PYTHON": "/databricks/python3/bin/python3"
  },
  "custom_tags": {
    "Department": "Finance",
    "Project": "Financial Data Pipeline",
    "Owner": "Finance Data Team"
  },
  "init_scripts": [
    {
      "dbfs": {
        "destination": "dbfs:/databricks/init/finance_cluster_init.sh"
      }
    }
  ],
  "libraries": [
    {
      "pypi": {
        "package": "delta-spark==1.0.0"
      }
    },
    {
      "pypi": {
        "package": "pandas==1.3.3"
      }
    },
    {
      "pypi": {
        "package": "numpy==1.21.2"
      }
    },
    {
      "maven": {
        "coordinates": "org.apache.spark:spark-avro_2.12:3.1.2"
      }
    }
  ],
  "enable_elastic_disk": true,
  "cluster_log_conf": {
    "dbfs": {
      "destination": "dbfs:/cluster-logs/finance-data-processing"
    }
  }
}